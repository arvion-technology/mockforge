{
  "name": "mockforge",
  "version": "1.0.0",
  "description": "Turn an OpenAPI 3 document into a stateful mock API server with seeded fixtures, validation, failure injection and request recording.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Arvion Technologies <hello@arviontech.net> (https://arviontech.net)",
  "homepage": "https://arvion-technology.github.io/labs/demos/mockforge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvion-technology/mockforge.git"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node scripts/serve.mjs . 4173",
    "shot": "node scripts/shot.mjs 1440 900 docs/screenshot.png",
    "shot:2": "node scripts/shot.mjs 1440 900 docs/screenshot-2.png #traffic",
    "verify": "node --test && node scripts/serve-check.mjs",
    "mock": "node scripts/cli.mjs serve examples/tasks.yaml --port 4010"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mockforge": "./scripts/cli.mjs"
  }
}
